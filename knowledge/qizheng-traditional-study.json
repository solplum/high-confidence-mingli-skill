  "rule_cards": [
    {
      "id": "QZT01",
      "selector": "palace_identity",
      "title": "宫支五行不能代替宫主",
      "source_ids": [
        "xd-digital-v2",
        "project-editorial"
      ],
      "conditions": [
        "明确宫支",
        "保持地支五行、宫主、宫主折合五行三字段"
      ],
      "counterconditions": [
        "误把卯木当卯宫主",
        "把日/月折五行当原书逐字规则"
      ],
      "plain_language": "同一个卯字可表示不同分类：地支属木，本项目七政宫主表却取火。先问正在算哪个概念，再谈生克；本卡不判庙旺。",
      "locators": [
        "卷四·星盤或問：十二宫与地支五行不同的问答；日月折火水仅项目约定"
      ],
      "positive_example": {
        "branch": "卯"
      },
      "counterexample": {
        "branch": "卯",
        "palace_lord": "木"
      },
      "scope": "traditional_structure_study_only",
      "personal_ledger_authorized": false,
      "predictive_validity": "unvalidated"
    },
    {
      "id": "QZT02",
      "selector": "dignity_terminology",
      "title": "庙乐垣的同名规则冲突门",
      "source_ids": [
        "project-editorial"
      ],
      "conditions": [
        "明确词项庙、乐或垣",
        "明确采用尚未校勘的旧整理体系"
      ],
      "counterconditions": [
        "把本宫、入庙表、乐宫表自动合成统一强弱分",
        "仅有宫支无法说明采用哪张表"
      ],
      "plain_language": "旧整理同时使用关系律与不同歌表。本卡的有用结果是指出缺少哪项选择，并拒绝给虚假的庙旺评分；不是删去异说。",
      "locators": [
        "references/qizheng/states-tables.md：喜宫歌关系律、入庙、乘旺·乐宫；只登记矛盾，不复制正文"
      ],
      "positive_example": {
        "term": "庙",
        "scheme": "unresolved-legacy-compilation"
      },
      "counterexample": {
        "term": "庙",
        "scheme": "universal"
      },
      "scope": "traditional_structure_study_only",
      "personal_ledger_authorized": false,
      "predictive_validity": "unvalidated"
    },
    {
      "id": "QZT03",
      "selector": "aspect_vs_branch",
      "title": "宫位关系与角距离分开核对",
      "source_ids": [
        "qy-ncl-scan",
        "project-editorial"
      ],
      "conditions": [
        "两黄经采用同一声明坐标框架",
        "明确双方宫支",
        "只计算与60/90/120/180度的残差，不私造容许度"
      ],
      "counterconditions": [
        "隔宫关系不保证精确角距",
        "近似宿宫模型不能换成等分十二宫",
        "原书吉凶结果不由几何独立推出"
      ],
      "plain_language": "本书先用角度说明相照，后面冲、钓又说明不必拘于精确角度。软件分别列出宫位关系和实际角差，不能因一个满足而声称另一个也满足。",
      "locators": [
        "PDF17右页·十二宮分度數相照",
        "PDF21左页·沖",
        "PDF22右页·鈎"
      ],
      "positive_example": {
        "longitude_a": 10,
        "longitude_b": 185,
        "branch_a": "子",
        "branch_b": "午",
        "coordinate_frame": "ecliptic-of-date"
      },
      "counterexample": {
        "longitude_a": 10,
        "longitude_b": 185,
        "branch_a": "子",
        "branch_b": "午",
        "coordinate_frame": "mixed"
      },
      "scope": "traditional_structure_study_only",
      "personal_ledger_authorized": false,
      "predictive_validity": "unvalidated"
    },
    {
      "id": "QZT04",
      "selector": "qianyuan_natal_palace",
      "title": "乾元定命取宫与果老论度保留分歧",
